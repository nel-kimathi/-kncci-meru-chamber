# Required: Resend API key for the contact form
# Create an account at https://resend.com, verify the meruchamber.co.ke domain,
# then set this in Vercel (Settings > Environment Variables). Never commit a real key.
RESEND_API_KEY=

# Optional: where contact form emails are sent to / from.
# Defaults to info@meruchamber.co.ke if not set.
CONTACT_FORM_TO=info@meruchamber.co.ke
CONTACT_FORM_FROM=info@meruchamber.co.ke
