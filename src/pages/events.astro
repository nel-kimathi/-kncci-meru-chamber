---
import Base from '../layouts/Base.astro';
import SectionDivider from '../components/SectionDivider.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

const upcoming = [
  { title: "Meru Business Forum Q3 2026", date: "2026-08-15", venue: "Meru Sports Club", desc: "Quarterly networking forum bringing together Meru business leaders and county officials for dialogue and connection.", img: "/images/events/event-networking.jpg" },
  { title: "Export Readiness Workshop", date: "2026-09-02", venue: "KNCCI Meru Office", desc: "Capacity building workshop on export documentation, compliance, and market access for horticultural producers.", img: "/images/events/event-workshop.jpg" },
  { title: "Annual Trade Fair 2026", date: "2026-10-20", venue: "Meru County Showground", desc: "The flagship annual trade exhibition showcasing Meru's products, services, and innovations to national and regional buyers.", img: "/images/events/event-trade-fair.jpg" },
  { title: "Business Networking Lunch", date: "2026-07-25", venue: "[Venue — pending]", desc: "Monthly networking lunch for members and prospective members to connect and explore collaboration opportunities.", img: "/images/events/event-networking.jpg" },
];

const past = [
  {
    title: "MOU Signing — Meru International Investors Conference",
    date: "2026-07-30",
    venue: "Meru University of Science and Technology",
    desc: "The Chamber hosted the signing of a tripartite Memorandum of Understanding that officially kicked off planning for the Meru International Investors Conference. The agreement unites key partners behind a shared vision to position Meru as a premier destination for investment, with the conference set to showcase the county's opportunities to national and international audiences.",
    img: "/images/events/event-mou-signing.jpg",
  },
  {
    title: "Bank of Baroda Dinner",
    date: "2026-02-17",
    venue: "Three Steers Hotel",
    desc: "An evening of dialogue and networking hosted by Bank of Baroda in partnership with KNCCI Meru Chapter. The dinner was aimed at building strong partnerships between the financial sector and local businesses, opening doors to credit, investment, and growth support for Meru's enterprises.",
    img: "/images/events/event-baroda-dinner.jpg",
  },
  {
    title: "Maua Business Dinner",
    date: "2025-12-11",
    venue: "Springwells, Maua, Meru County",
    desc: "Held to celebrate success and shape the future of Maua, this dinner brought together traders, entrepreneurs, and community leaders from Meru County's thriving second town — recognising achievements, forging new partnerships, and charting the town's economic path forward.",
    img: "/images/events/event-maua-dinner.jpg",
  },
];
---

<Base title="Events" description="Upcoming and past events by KNCCI Meru Chapter — trade fairs, business forums, networking events, and training workshops.">
  <!-- Page Hero -->
  <section class="relative bg-black py-20 lg:py-32 min-h-[50vh] flex items-center">
    <div class="absolute inset-0">
      <img src="/images/heroes/events.jpg" alt="KNCCI Meru Chapter — Chamber Events" class="w-full h-full object-cover object-top opacity-50" />
      <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/50 to-transparent"></div>
    </div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="max-w-xl lg:max-w-2xl">
        <p class="font-mono text-red text-xs uppercase tracking-widest mb-3">Calendar</p>
        <h1 class="font-display font-black text-4xl sm:text-5xl lg:text-5xl text-white leading-tight mb-4">Chamber Events</h1>
        <p class="text-white/70 text-lg lg:text-xl leading-relaxed">
          Trade fairs, business forums, training workshops, and networking events — stay connected with the Meru business community.
        </p>
      </div>
    </div>
  </section>

  <SectionDivider class="my-0" />

  <!-- Upcoming Events -->
  <section class="bg-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10">
        <p class="font-mono text-red text-xs uppercase tracking-widest mb-2">Coming Up</p>
        <h2 class="font-display font-black text-3xl lg:text-4xl text-black">Upcoming Events</h2>
      </div>
      <div class="grid sm:grid-cols-2 gap-6 lg:gap-8">
        {upcoming.map((ev) => (
          <div class="card-reveal group bg-white border border-black/10 rounded-sm overflow-hidden hover:border-red/40 transition-all duration-300">
            <div class="aspect-[3/2] overflow-hidden">
              <img src={ev.img} alt={ev.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
            </div>
            <div class="p-6">
              <div class="flex items-center gap-3 mb-3">
                <span class="font-mono text-xs text-red bg-red/10 px-2 py-0.5 rounded-sm">
                  {new Date(ev.date).toLocaleDateString('en-KE', { year: 'numeric', month: 'short', day: 'numeric' })}
                </span>
                <span class="font-mono text-xs text-black/40">{ev.venue}</span>
              </div>
              <h3 class="font-display font-bold text-lg text-black mb-2 group-hover:text-red transition-colors">{ev.title}</h3>
              <p class="text-black/60 text-sm leading-relaxed">{ev.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <ScrollReveal />

  <SectionDivider class="my-0" />

  <!-- Past Events -->
  <section class="bg-black py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10">
        <p class="font-mono text-red text-xs uppercase tracking-widest mb-2">Archive</p>
        <h2 class="font-display font-black text-3xl lg:text-4xl text-white">Past Events</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {past.map((ev) => (
          <div class="card-reveal group bg-white/5 border border-white/10 rounded-sm overflow-hidden">
            <div class="aspect-[3/2] overflow-hidden">
              <img src={ev.img} alt={ev.title} class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity duration-300" loading="lazy" />
            </div>
            <div class="p-5">
              <div class="flex items-center gap-3 mb-2">
                <span class="font-mono text-xs text-red">
                  {new Date(ev.date).toLocaleDateString('en-KE', { year: 'numeric', month: 'short', day: 'numeric' })}
                </span>
              </div>
              <h3 class="font-display font-bold text-base text-white mb-2">{ev.title}</h3>
              <p class="text-white/50 text-sm leading-relaxed">{ev.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectionDivider class="my-0" />

  <!-- Facebook Feed -->
  <section class="bg-white py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="font-mono text-red text-xs uppercase tracking-widest mb-2">Social</p>
        <h2 class="font-display font-black text-3xl lg:text-4xl text-black">From Our Facebook</h2>
      </div>
      <div class="flex justify-center">
        <div class="fb-page" data-href="https://www.facebook.com/profile.php?id=61572837654875" data-tabs="timeline" data-width="800" data-height="600" data-small-header="false" data-adapt-container-width="true" data-hide-cover="false" data-show-facepile="true">
          <blockquote cite="https://www.facebook.com/profile.php?id=61572837654875" class="fb-xfbml-parse-ignore">
            <a href="https://www.facebook.com/profile.php?id=61572837654875">KNCCI Meru Chapter</a>
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    if (typeof FB !== 'undefined') {
      FB.XFBML.parse();
    } else {
      window.fbAsyncInit = function() {
        FB.init({ xfbml: true, version: 'v19.0' });
      };
    }
  </script>
</Base>
